# npm run setup creates .env with fresh credentials. This template is reference only.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://pharmaflow:YOUR_DATABASE_PASSWORD@localhost:5432/pharmaflow
DB_PASSWORD=YOUR_DATABASE_PASSWORD
JWT_SECRET=GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=false
BUSINESS_TIMEZONE=Asia/Karachi
TRUST_PROXY=0
SEED_DEMO=true
SEED_ADMIN_EMAIL=admin@pharmaflow.local
SEED_ADMIN_PASSWORD=CHOOSE_A_PRIVATE_PASSWORD_OF_AT_LEAST_12_CHARACTERS
